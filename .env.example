# MySQL or TiDB Cloud. Never commit a real .env file.
# Local MySQL example:
DATABASE_URL=mysql+pymysql://dineoff:dineoff@localhost:3306/dineoff

# TiDB Cloud example (SSL is enabled automatically for tidbcloud.com hosts):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@gateway01.example.prod.aws.tidbcloud.com:4000/dineoff?ssl=true

# Optional. Leave blank to use the built-in mock services.
GEMINI_API_KEY=
GEOAPIFY_API_KEY=

# Frontend only. This is safe to expose in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional comma-separated list used by the API.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
