# MySQL or TiDB Cloud. Never commit a real .env file.
# Local MySQL example:
DATABASE_URL=mysql+pymysql://dineoff:dineoff@localhost:3306/dineoff

# TiDB Cloud example (SSL is enabled automatically for tidbcloud.com hosts):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@gateway01.example.prod.aws.tidbcloud.com:4000/dineoff?ssl=true

# Optional. Backend only. Leave blank to use the built-in mock parser.
# Never expose this as NEXT_PUBLIC_GEMINI_API_KEY. The browser must not receive it.
GEMINI_API_KEY=
GEOAPIFY_API_KEY=

# Frontend only. This is safe to expose in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional comma-separated list for deployed frontends.
# Localhost on any port is already allowed, including when Next.js is not on 3000.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
